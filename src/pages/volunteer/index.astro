---
import Rescue from '../../layouts/Rescue.astro';
import ShiftBoard from '../../components/ShiftBoard.tsx';
---
<Rescue title="Volunteer shifts" description="Pick a volunteer shift at Maple Hollow Animal Rescue and sign up online." eyebrow="Lend a hand" heading="Volunteer shifts" lead="Choose a shift, add your name and email, and you are signed up. You can cancel from this page.">
  <div class="wrap body">
    <ShiftBoard client:load />
    <noscript><p>Sign-up needs JavaScript in this demo. A real site would also take sign-ups by email or phone.</p></noscript>
  </div>
</Rescue>
