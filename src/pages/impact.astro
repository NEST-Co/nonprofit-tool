---
import Rescue from '../layouts/Rescue.astro';
import Photo from '../components/Photo.astro';
const data = [
  { year: '2021', n: 112 }, { year: '2022', n: 138 }, { year: '2023', n: 151 },
  { year: '2024', n: 176 }, { year: '2025', n: 194 }, { year: '2026', n: 163, note: 'so far, to October' },
];
const max = Math.max(...data.map((d) => d.n));
---
<Rescue title="Our impact" description="How many animals Maple Hollow Animal Rescue has placed in homes each year." eyebrow="By the numbers" heading="Our impact" lead="These figures are invented for this concept site. A real organization would use its own records.">
  <div class="wrap body">
    <div class="split">
      <figure style="margin:0">
        <figcaption id="cap">Animals adopted each year</figcaption>
        <ol class="hbars" aria-labelledby="cap">
          {data.map((d) => (
            <li><span class="yr">{d.year}</span>
              <span class="track"><span class="fill" aria-hidden="true" style={`width:${(d.n / max) * 80}%`}></span><span class="val">{d.n}{d.note && <span class="meta"> ({d.note})</span>}</span></span></li>
          ))}
        </ol>
      </figure>
      <div class="frame"><Photo name="adoption" alt="A family welcoming a newly adopted dog at their front door, a child kneeling to hug it." sizes="(min-width: 900px) 45vw, 100vw" /></div>
    </div>
    <h2 style="margin-top:3rem">Where a gift goes</h2>
    <ul class="grid3" style="margin-top:1rem">
      <li class="panel"><h3>Food and supplies</h3><p>Meals, litter and everyday care.</p></li>
      <li class="panel"><h3>Vet care</h3><p>Vaccines and spay or neuter surgery.</p></li>
      <li class="panel"><h3>Comfort</h3><p>Bedding, toys and cleaning supplies.</p></li>
    </ul>
  </div>
</Rescue>
