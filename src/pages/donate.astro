---
import Rescue from '../layouts/Rescue.astro';
---
<Rescue title="Donate" description="Ways to support Maple Hollow Animal Rescue.">
  <div class="wrap prose">
    <h1>Ways to give</h1>
    <p>This is a concept site for a fictional rescue, so there is no payment form.</p>
    <h2>Give money</h2>
    <p>A real site would link to a secure donation page here, and state clearly how the money is used and whether gifts are tax deductible.</p>
    <h2>Give supplies</h2>
    <ul><li>Dry and canned dog and cat food</li><li>Towels and blankets</li><li>Cleaning supplies and paper towels</li></ul>
    <h2>Give time</h2>
    <p><a href="/volunteer">Sign up for a volunteer shift.</a></p>
  </div>
</Rescue>
