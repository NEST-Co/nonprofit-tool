---
import Rescue from '../layouts/Rescue.astro';
import Photo from '../components/Photo.astro';
---
<Rescue title="Donate" description="Ways to support Maple Hollow Animal Rescue." eyebrow="Every bit helps" heading="Ways to give" lead="This is a concept site for a fictional rescue, so there is no payment form.">
  <div class="wrap body">
    <div class="split" style="margin-bottom:3rem">
      <div class="frame"><Photo name="supplies" alt="Donation bins filled with pet food, folded blankets, leashes and toys." sizes="(min-width: 900px) 45vw, 100vw" /></div>
      <div class="two" style="grid-template-columns:1fr">
        <div class="panel"><h2>Give money</h2><p>A real site would link to a secure donation page here, and state clearly how the money is used and whether gifts are tax deductible.</p></div>
        <div class="panel"><h2>Give supplies</h2><ul><li>Dry and canned dog and cat food</li><li>Towels and blankets</li><li>Cleaning supplies and paper towels</li></ul></div>
        <div class="panel"><h2>Give time</h2><p><a href="/volunteer">Sign up for a volunteer shift.</a></p></div>
      </div>
    </div>
  </div>
</Rescue>
