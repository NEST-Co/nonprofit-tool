---
import Rescue from '../layouts/Rescue.astro';
---
<Rescue title="Welcome" description="Maple Hollow Animal Rescue finds homes for dogs and cats. See how to volunteer, donate or adopt.">
  <div class="hero"><div class="wrap">
    <h1>Every animal deserves a home</h1>
    <p>Maple Hollow Animal Rescue takes in dogs and cats, cares for them, and finds them families. Volunteers make that possible.</p>
    <a class="btn" href="/volunteer">Find a volunteer shift</a>
  </div></div>
  <div class="wrap">
    <h2>This year so far</h2>
    <ul class="stats">
      <li><strong>163</strong>animals adopted</li>
      <li><strong>212</strong>volunteer shifts filled</li>
      <li><strong>38</strong>foster homes</li>
    </ul>
    <p class="meta">These numbers are invented for this concept site.</p>
    <div class="two">
      <section>
        <h2>Volunteer with us</h2>
        <p>Walk dogs, brush cats, help at adoption events or drive animals to the vet. Pick a shift that fits your week and sign up in a minute.</p>
        <p><a href="/volunteer">See open shifts</a></p>
      </section>
      <section>
        <h2>Give</h2>
        <p>A gift covers food, vet care and bedding. See where your money goes.</p>
        <p><a href="/donate">Ways to give</a> · <a href="/impact">Our impact</a></p>
      </section>
    </div>
  </div>
</Rescue>
