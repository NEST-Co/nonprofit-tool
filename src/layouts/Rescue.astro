---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/maple.css';
interface Props { title: string; description?: string; heading?: string; lead?: string; eyebrow?: string; home?: boolean }
const site = { name: 'Maple Hollow Animal Rescue', phone: '(555) 010-0177', email: 'hello@maplehollow-rescue.example', address: '27 Orchard Road, Maple Hollow' };
const nav = [
  { href: '/adopt', label: 'Adopt' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/impact', label: 'Our impact' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const { title, description = `${title}: ${site.name}, a fictional animal rescue.`, heading, lead, eyebrow, home = false } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} siteName={site.name}>
  <div slot="header" class="site-head">
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span class="brand-text"><span class="brand-name">Maple Hollow</span><span class="brand-sub">Animal Rescue</span></span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a class="give" href="/donate" aria-current={path.startsWith('/donate') ? 'page' : undefined}>Donate</a></li>
        </ul>
      </nav>
    </div>
  </div>
  {!home && heading && (
    <div class="page-head">
      <div class="wrap">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
    </div>
  )}
  <slot />
  <div slot="footer" class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <p class="foot-name">{site.name}</p>
        <p>{site.address}</p>
        <p>{site.phone}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <h2>Around the site</h2>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/donate">Donate</a></li></ul>
      </div>
      <div>
        <h2>More</h2>
        <ul><li><a href="/volunteer/coordinator">Coordinator view</a></li><li><a href="/accessibility">Accessibility statement</a></li></ul>
      </div>
    </div>
  </div>
</Base>
